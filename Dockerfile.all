FROM python:3.11-slim

WORKDIR /app

# Install Node.js, nginx, and supervisor
RUN apt-get update && apt-get install -y \
    curl \
    supervisor \
    nginx \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY backend/services/auth-service/requirements.txt /tmp/auth-requirements.txt
COPY backend/services/doctor-service/requirements.txt /tmp/doctor-requirements.txt
COPY backend/services/appointment-service/requirements.txt /tmp/appointment-requirements.txt
COPY backend/services/user-service/requirements.txt /tmp/user-requirements.txt
COPY backend/services/notification-service/requirements.txt /tmp/notification-requirements.txt

RUN pip install --no-cache-dir -r /tmp/auth-requirements.txt \
    && pip install --no-cache-dir -r /tmp/doctor-requirements.txt \
    && pip install --no-cache-dir -r /tmp/appointment-requirements.txt \
    && pip install --no-cache-dir -r /tmp/user-requirements.txt \
    && pip install --no-cache-dir -r /tmp/notification-requirements.txt

# Copy all backend services
COPY backend/services/auth-service /app/auth-service
COPY backend/services/doctor-service /app/doctor-service
COPY backend/services/appointment-service /app/appointment-service
COPY backend/services/user-service /app/user-service
COPY backend/services/notification-service /app/notification-service

# Copy frontend and build
COPY frontend /app/frontend
WORKDIR /app/frontend
RUN npm install && npm run build

# Copy supervisor configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Enable nginx default site
RUN rm -f /etc/nginx/sites-enabled/default

# Copy entrypoint script
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Expose port 8080 for nginx
EXPOSE 8080

WORKDIR /app

ENTRYPOINT ["/app/entrypoint.sh"]
