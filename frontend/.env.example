# Environment Variables for Healthcare Appointment System Frontend
# Copy this file to .env and update with your actual URLs

# Development URLs (localhost) - Default fallback
# VITE_AUTH_URL=http://localhost:8001
# VITE_USER_URL=http://localhost:8002
# VITE_DOCTOR_URL=http://localhost:8003
# VITE_APPOINTMENT_URL=http://localhost:8004
# VITE_NOTIFICATION_URL=http://localhost:8005

# Production URLs (Render.com) - Uncomment these for production
VITE_AUTH_URL=https://healthcare-auth-service.onrender.com
VITE_USER_URL=https://healthcare-user-service.onrender.com
VITE_DOCTOR_URL=https://healthcare-doctor-service.onrender.com
VITE_APPOINTMENT_URL=https://healthcare-appointment-service.onrender.com
VITE_NOTIFICATION_URL=https://healthcare-notification-service.onrender.com
